{
  "name": "@sixb/blob-azure",
  "version": "0.1.1",
  "description": "Azure Blob Storage for Sixb fileRef payloads",
  "keywords": [
    "sixb",
    "bun",
    "storage",
    "blob",
    "azure",
    "files"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "storage/blob-azure"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test --preload ./tests/setup.ts ./tests/*.e2e.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@azure/core-auth": "1.10.1",
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.33.0"
  },
  "peerDependencies": {
    "@sixb/core": "workspace:^"
  },
  "devDependencies": {
    "@sixb/client": "workspace:*",
    "@sixb/core": "workspace:*",
    "@sixb/server": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

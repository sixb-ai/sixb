{
  "name": "@sixb/server",
  "version": "0.1.3",
  "description": "HTTP and WebSocket API server for Sixb",
  "keywords": [
    "sixb",
    "bun",
    "api",
    "openapi",
    "elysia"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/server"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/openapi": "^1.4.0",
    "elysia": "^1.2.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependencies": {
    "@sixb/core": "workspace:*"
  },
  "devDependencies": {
    "@sixb/auth-magic-link": "workspace:*",
    "@sixb/auth-oidc": "workspace:*",
    "@sixb/core": "workspace:*",
    "@sixb/sqlite": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}

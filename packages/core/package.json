{
  "name": "@sixb/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ontology": {
      "types": "./dist/ontology/index.d.ts",
      "bun": "./src/ontology/index.ts",
      "import": "./dist/ontology/index.js",
      "default": "./dist/ontology/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "bun": "./src/query.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./events/scope": {
      "types": "./dist/events/scope.d.ts",
      "bun": "./src/events/scope.ts",
      "import": "./dist/events/scope.js",
      "default": "./dist/events/scope.js"
    },
    "./actions/worker": {
      "types": "./dist/actions/worker.d.ts",
      "bun": "./src/actions/worker.ts",
      "import": "./dist/actions/worker.js",
      "default": "./dist/actions/worker.js"
    },
    "./agents/streams": {
      "types": "./dist/agents/streams.d.ts",
      "bun": "./src/agents/streams.ts",
      "import": "./dist/agents/streams.js",
      "default": "./dist/agents/streams.js"
    },
    "./blob-storage": {
      "types": "./dist/blob-storage/browser.d.ts",
      "bun": "./src/blob-storage/browser.ts",
      "import": "./dist/blob-storage/browser.js",
      "default": "./dist/blob-storage/browser.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}

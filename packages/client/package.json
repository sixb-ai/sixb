{
  "name": "@sixb/client",
  "version": "0.1.2",
  "description": "Type-safe SDK for Sixb API with TanStack Query hooks",
  "keywords": [
    "sixb",
    "bun",
    "sdk",
    "react",
    "tanstack-query"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/client"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "bun": "./src/browser.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./logs": {
      "types": "./dist/logs.d.ts",
      "bun": "./src/logs.ts",
      "import": "./dist/logs.js",
      "default": "./dist/logs.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "bun": "./src/hooks.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "bun": "./src/models.ts",
      "import": "./dist/models.js",
      "default": "./dist/models.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "bun": "./src/query.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    }
  },
  "scripts": {
    "generate": "openapi-ts",
    "typecheck": "tsc --noEmit",
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@sixb/core": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

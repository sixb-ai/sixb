{
  "name": "@pario/client",
  "version": "0.1.0",
  "description": "Type-safe SDK for Pario API with TanStack Query hooks",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks.ts",
    "./models": "./src/models.ts"
  },
  "scripts": {
    "generate": "openapi-ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tanstack/react-query": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}

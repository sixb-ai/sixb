{
  "name": "@sixb/cli",
  "version": "0.2.10",
  "description": "Unified command-line interface for Sixb instances and projects",
  "keywords": [
    "sixb",
    "cli",
    "bun",
    "node"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/cli"
  },
  "author": "Sixb contributors",
  "type": "module",
  "bin": {
    "sixb": "./src/bin/sixb"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "generate:cli": "bun ./scripts/generate-cli.ts",
    "check:cli": "bun ./scripts/generate-cli.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

{
  "name": "@sixb/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sixb": "./dist/index.js",
    "create-sixb": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test ./tests/prod-roles.e2e.ts && bun test ./tests/worker-group.e2e.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@sixb/app": "workspace:*",
    "@sixb/action-worker": "workspace:*",
    "@sixb/atlas": "workspace:*",
    "@sixb/core": "workspace:*",
    "@sixb/orchestrator": "workspace:*",
    "@sixb/pipeline-worker": "workspace:*",
    "@sixb/projection-worker": "workspace:*",
    "@sixb/rules-worker": "workspace:*",
    "@sixb/server": "workspace:*",
    "@sixb/sync-worker": "workspace:*",
    "@sixb/workflow-worker": "workspace:*",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "react-devtools-core": "^4.19.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.tsx",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sixbBuild": {
    "assets": [
      {
        "from": "../../templates/basic",
        "to": "./dist/templates/basic"
      }
    ]
  }
}

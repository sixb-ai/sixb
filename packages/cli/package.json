{
  "name": "@sixb/cli",
  "version": "0.1.1",
  "description": "Command-line interface for Sixb projects",
  "keywords": [
    "sixb",
    "bun",
    "cli"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/cli"
  },
  "author": "Sixb contributors",
  "type": "module",
  "bin": {
    "sixb": "./src/index.tsx"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test ./tests/build.e2e.ts && bun test ./tests/prod-roles.e2e.ts && bun test ./tests/worker-group.e2e.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@sixb/action-worker": "workspace:*",
    "@sixb/agent-worker": "workspace:*",
    "@sixb/app": "workspace:^",
    "@sixb/atlas": "workspace:^",
    "@sixb/client": "workspace:^",
    "@sixb/core": "workspace:*",
    "@sixb/orchestrator": "workspace:*",
    "@sixb/pipeline-worker": "workspace:*",
    "@sixb/projection-worker": "workspace:*",
    "@sixb/rules-worker": "workspace:*",
    "@sixb/server": "workspace:*",
    "@sixb/sync-worker": "workspace:*",
    "@sixb/workflow-worker": "workspace:*",
    "create-sixb": "workspace:^",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "react-devtools-core": "^4.19.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

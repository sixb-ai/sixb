{
  "name": "@sixb/app",
  "version": "0.2.4",
  "description": "Custom app toolkit for Sixb projects — route scanning, dev serving, and production builds",
  "keywords": [
    "sixb",
    "bun",
    "react",
    "router"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/app"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "bun": "./src/pages.ts",
      "import": "./dist/pages.js",
      "default": "./dist/pages.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "bun": "./src/locale.ts",
      "import": "./dist/locale.js",
      "default": "./dist/locale.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test:e2e": "bun ../../scripts/ci-guard.ts --stall 60 --max 180 bun test ./tests/app-entry.e2e.ts ./tests/build-browser.e2e.ts ./tests/shared-shell.e2e.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "generate:frame-editor": "bun ./scripts/generate-frame-editor.ts"
  },
  "dependencies": {
    "@sixb/client": "workspace:^",
    "@sixb/core": "workspace:^",
    "@sixb/ui": "workspace:^",
    "@tailwindcss/cli": "^4.2.2",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-code-block": "^3.33.1",
    "@tiptap/extension-collaboration": "^3.33.1",
    "@tiptap/extension-collaboration-caret": "^3.33.1",
    "@tiptap/extension-drag-handle": "^3.33.1",
    "@tiptap/extension-drag-handle-react": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-node-range": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "@tiptap/y-tiptap": "^3.3.0",
    "@xyflow/react": "^12.10.2",
    "lib0": "0.2.119",
    "lucide-react": "^0.562.0",
    "parse5": "^8.0.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.1.18",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.6",
    "libphonenumber-js": "1.13.9",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}

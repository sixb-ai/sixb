{
  "name": "@sixb/ui",
  "version": "0.1.0",
  "description": "Shared Sixb UI foundations and components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "bun": "./src/components/index.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "bun": "./src/components/ui/*.tsx",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "bun": "./src/hooks/index.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./hooks/*.ts": {
      "types": "./dist/hooks/*.d.ts",
      "bun": "./src/hooks/*.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./hooks/*.tsx": {
      "types": "./dist/hooks/*.d.ts",
      "bun": "./src/hooks/*.tsx",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "bun": [
        "./src/hooks/*.ts",
        "./src/hooks/*.tsx"
      ],
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "bun": "./src/lib/index.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "bun": "./src/lib/utils.ts",
      "import": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --hot ./dev/server.ts",
    "build:preview": "NODE_ENV=production bun build ./dev/index.html --outdir ./dev/dist --minify",
    "shadcn:add": "bunx --bun shadcn@latest add",
    "typecheck": "tsc --noEmit",
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.6.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-plugin-tailwind": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}

{
  "name": "@sixb/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Sixb UI foundations and components",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/common/*": "./src/components/common/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*.ts": "./src/hooks/*.ts",
    "./hooks/*.tsx": "./src/hooks/*.tsx",
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ],
    "./lib": "./src/lib/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --hot ./dev/server.ts",
    "build:preview": "NODE_ENV=production bun build ./dev/index.html --outdir ./dev/dist --minify",
    "shadcn:add": "bunx --bun shadcn@latest add",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-plugin-tailwind": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0"
  }
}

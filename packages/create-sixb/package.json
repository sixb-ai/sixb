{
  "name": "create-sixb",
  "version": "0.1.1",
  "description": "Create a new Sixb project",
  "keywords": [
    "sixb",
    "bun",
    "scaffold",
    "starter"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/create-sixb"
  },
  "author": "Sixb contributors",
  "type": "module",
  "bin": {
    "create-sixb": "./dist/index.js"
  },
  "exports": {
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "bun": "./dist/scaffold.js",
      "import": "./dist/scaffold.js",
      "default": "./dist/scaffold.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force && bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "cobe": "^2.0.1",
    "react": "^19.0.0",
    "satellite.js": "^7.1.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sixbBuild": {
    "entrypoints": [
      "./src/index.ts",
      "./src/scaffold.ts"
    ],
    "assets": [
      {
        "from": "./template",
        "to": "./dist/template"
      }
    ]
  }
}

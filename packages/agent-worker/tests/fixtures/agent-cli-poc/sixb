print_query_example() {
  case "$1" in
    list)
      printf '%s\n' "exact filter incoming expand sort page facets"
      ;;
    exact)
      cat <<'EOF'
{"kind":"refs","refs":[{"objectTypeId":"RepositoryIssue","primaryId":"github:issue:owner/repo#297"}]}
EOF
      ;;
    filter)
      cat <<'EOF'
{"kind":"limit","input":{"kind":"filter","input":{"kind":"start","objectTypeId":"Customer"},"predicate":{"op":"eq","propertyId":"status","value":"active"}},"limit":20}
EOF
      ;;
    incoming)
      cat <<'EOF'
{"kind":"traverse","input":{"kind":"refs","refs":[{"objectTypeId":"RepositoryIssue","primaryId":"github:issue:owner/repo#297"}]},"linkId":"issue","direction":"incoming","sourceObjectTypeId":"RepositoryComment"}
EOF
      ;;
    expand)
      cat <<'EOF'
{"kind":"expand","input":{"kind":"refs","refs":[{"objectTypeId":"RepositoryIssue","primaryId":"github:issue:owner/repo#297"}]},"expansions":[{"linkId":"issue","direction":"incoming","sourceObjectTypeId":"RepositoryComment","limit":20}]}
EOF
      ;;
    sort)
      cat <<'EOF'
{"kind":"limit","input":{"kind":"sort","input":{"kind":"start","objectTypeId":"Customer"},"fields":[{"kind":"property","propertyId":"name","direction":"asc"}]},"limit":20}
EOF
      ;;
    page)
      cat <<'EOF'
{"kind":"page","input":{"kind":"start","objectTypeId":"Customer"},"pageSize":20,"pageToken":"optional-token-from-previous-response"}
EOF
      ;;
    facets)
      cat <<'EOF'
{"query":{"kind":"start","objectTypeId":"WorkOrder"},"facets":[{"propertyId":"status","limit":10}]}
EOF
      ;;
    *)
      fail "Unknown query example '$1'. Run 'sixb objects query --example list'."
      ;;
  esac
}

cmd_doctor() {
  is_help "${1:-}" && {
    printf '%s\n' "Usage: sixb doctor"
    return
  }

  local missing=""
  [[ -n "${SIXB_API_BASE_URL:-}" ]] || missing="SIXB_API_BASE_URL"
  [[ -n "$(command -v curl)" ]] || missing="${missing:+$missing,}curl"
  [[ -n "$(command -v jq)" ]] || missing="${missing:+$missing,}jq"
  [[ -z "$missing" ]] || fail "Missing required runtime: $missing" "runtime_unavailable"

  local project
  project="$(http_get "/api/project")"
  jq -cn \
    --arg cliVersion "$SIXB_AGENT_CLI_VERSION" \
    --arg apiBaseUrl "$SIXB_API_BASE_URL" \
    --argjson project "$project" \
    '{ok:true,cliVersion:$cliVersion,apiBaseUrl:$apiBaseUrl,dependencies:{bash:true,curl:true,jq:true},project:$project}'
}

cmd_context() {
  is_help "${1:-}" && {
    printf '%s\n' "Usage: sixb context"
    return
  }
  [[ -n "${SIXB_RUN_CONTEXT:-}" ]] || fail "SIXB_RUN_CONTEXT is not set."
  [[ -f "$SIXB_RUN_CONTEXT" ]] || fail "Run context '$SIXB_RUN_CONTEXT' does not exist."
  cat "$SIXB_RUN_CONTEXT"
  printf '\n'
}

cmd_project() {
  local sub="${1:-}"
  if [[ -z "$sub" ]] || is_help "$sub"; then
    printf '%s\n' "Usage: sixb project show"
    return
  fi
  [[ "$sub" == "show" ]] || fail "Unknown project command '$sub'."
  [[ $# -eq 1 ]] || fail "project show accepts no arguments."
  require_runtime
  http_get "/api/project"
}

cmd_ontology() {
  local sub="${1:-}"
  shift || true
  if [[ -z "$sub" ]] || is_help "$sub"; then
    cat <<'EOF'
Usage:
  sixb ontology list [--full]
  sixb ontology get <object-type>

`ontology list` is compact by default. Use --full only when complete definitions for every visible
type are truly needed. Use ids exactly as returned; they are case-sensitive.
EOF
    return
  fi
  case "$sub" in
    list)
      is_help "${1:-}" && {
        printf '%s\n' "Usage: sixb ontology list [--full]"
        return
      }
      require_runtime
      local full="false"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --full) full="true"; shift ;;
          *) fail "Unknown ontology list option '$1'." ;;
        esac
      done
      local ontology
      ontology="$(http_get "/api/object-types")"
      if [[ "$full" == "true" ]]; then
        printf '%s\n' "$ontology"
      else
        jq -c 'map({
          id,
          name,
          description,
          primaryPropertyId: ([.properties[]? | select(.primary == true) | .id][0]),
          links: [.links[]? | {id, name, description, targetObjectTypeId, cardinality}],
          actions: [.actions[]? | {id, name, description}]
        })' <<<"$ontology"
      fi
      ;;
    get)
      is_help "${1:-}" && {
        printf '%s\n' "Usage: sixb ontology get <object-type>"
        return
      }
      require_runtime
      require_value "ontology get" "${1:-}"
      [[ $# -eq 1 ]] || fail "ontology get requires exactly one object type."
      http_get "/api/object-types/$(encode_segment "$1")"
      ;;
    *)
      fail "Unknown ontology command '$sub'."
      ;;
  esac
}

cmd_objects_list() {
  if is_help "${1:-}"; then
    print_objects_help
    return
  fi
  require_runtime
  local -a args=(--get "$(api_url "/api/objects")")
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) require_value "$1" "${2:-}"; args+=(--data-urlencode "objectTypeId=$2"); shift 2 ;;
      --limit) require_value "$1" "${2:-}"; args+=(--data-urlencode "limit=$2"); shift 2 ;;
      --offset) require_value "$1" "${2:-}"; args+=(--data-urlencode "offset=$2"); shift 2 ;;
      --order-by) require_value "$1" "${2:-}"; args+=(--data-urlencode "orderBy=$2"); shift 2 ;;
      --order) require_value "$1" "${2:-}"; args+=(--data-urlencode "order=$2"); shift 2 ;;
      --id-prefix) require_value "$1" "${2:-}"; args+=(--data-urlencode "idPrefix=$2"); shift 2 ;;
      --id-suffix) require_value "$1" "${2:-}"; args+=(--data-urlencode "idSuffix=$2"); shift 2 ;;
      --created-after) require_value "$1" "${2:-}"; args+=(--data-urlencode "createdAfter=$2"); shift 2 ;;
      --created-before) require_value "$1" "${2:-}"; args+=(--data-urlencode "createdBefore=$2"); shift 2 ;;
      --updated-after) require_value "$1" "${2:-}"; args+=(--data-urlencode "updatedAfter=$2"); shift 2 ;;
      --updated-before) require_value "$1" "${2:-}"; args+=(--data-urlencode "updatedBefore=$2"); shift 2 ;;
      *) fail "Unknown objects list option '$1'." ;;
    esac
  done
  http_json "${args[@]}"
}

cmd_objects_inspect() {
  if is_help "${1:-}"; then
    cat <<'EOF'
Usage: sixb objects inspect <object-type> <primary-id> [--depth <0-3>] [--max-objects <1-100>] [--full]

Returns the exact object plus a hydrated, de-duplicated graph of relationships in both directions.
Depth defaults to 2 and max objects defaults to 40 (including the requested object). Use --full to
include materialization timestamps and ontology definitions with declared links and actions.
EOF
    return
  fi

  local object_type="${1:-}"
  local primary_id="${2:-}"
  require_value "objects inspect object type" "$object_type"
  require_value "objects inspect primary id" "$primary_id"
  shift 2 || true

  local depth="2"
  local max_objects="40"
  local full="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --depth) require_value "$1" "${2:-}"; depth="$2"; shift 2 ;;
      --max-objects) require_value "$1" "${2:-}"; max_objects="$2"; shift 2 ;;
      --full) full="true"; shift ;;
      *) fail "Unknown objects inspect option '$1'." ;;
    esac
  done
  [[ "$depth" =~ ^[0-3]$ ]] || fail "--depth must be an integer from 0 through 3."
  [[ "$max_objects" =~ ^[1-9][0-9]*$ ]] || fail "--max-objects must be an integer from 1 through 100."
  max_objects="$((10#$max_objects))"
  (( max_objects <= 100 )) || fail "--max-objects must be an integer from 1 through 100."
  require_runtime

  local refs frontier objects links truncated
  refs="$(jq -cn --arg type "$object_type" --arg id "$primary_id" \
    '[{objectTypeId:$type,primaryId:$id,distance:0}]')"
  frontier="$refs"
  objects='[]'
  links='[]'
  truncated='false'

  # Depth zero still uses the link terminal once because includeObjects hydrates
  # the exact root without an ontology lookup or a second object request.
  local iterations="$depth"
  (( iterations > 0 )) || iterations=1

  local level
  for ((level = 0; level < iterations; level += 1)); do
    local frontier_count
    frontier_count="$(jq -r 'length' <<<"$frontier")"
    [[ "$frontier_count" -gt 0 ]] || break

    local selector page_token level_objects level_links
    selector="$(jq -c 'map({objectTypeId,primaryId})' <<<"$frontier")"
    page_token=''
    level_objects='[]'
    level_links='[]'

    while true; do
      local body response valid page_links has_more
      body="$(jq -cn \
        --argjson refs "$selector" \
        --arg pageToken "$page_token" '
          {
            query:{kind:"refs",refs:$refs},
            direction:"both",
            includeObjects:true,
            pageSize:1000
          }
          + (if $pageToken == "" then {} else {pageToken:$pageToken} end)
        ')"
      response="$(http_post_json "/api/objects/query/links" "$body")"
      valid="$(jq -r '
        (.objects | type == "array")
        and (.links | type == "array")
        and (.hasMore | type == "boolean")
      ' <<<"$response")"
      [[ "$valid" == "true" ]] || fail "The object-links API returned an invalid response."

      level_objects="$(jq -cn \
        --argjson existing "$level_objects" \
        --argjson incoming "$(jq -c '.objects' <<<"$response")" '
          $existing + $incoming
          | sort_by(.objectTypeId, .primaryId)
          | unique_by(.objectTypeId, .primaryId)
        ')"
      page_links="$(jq -c '[.links[] | {
        sourceTypeId:.source.objectTypeId,
        sourceId:.source.primaryId,
        linkId,
        targetTypeId:.target.objectTypeId,
        targetId:.target.primaryId
      } + (if has("properties") then {properties} else {} end)]' <<<"$response")"
      level_links="$(jq -cn \
        --argjson existing "$level_links" \
        --argjson incoming "$page_links" '
          $existing + $incoming
          | sort_by(.sourceTypeId, .sourceId, .linkId, .targetTypeId, .targetId)
          | unique_by(.sourceTypeId, .sourceId, .linkId, .targetTypeId, .targetId)
        ')"

      has_more="$(jq -r '.hasMore' <<<"$response")"
      [[ "$has_more" == "true" && "$level" -lt "$depth" ]] || break
      page_token="$(jq -er '.nextPageToken // empty' <<<"$response")" ||
        fail "The object-links API reported another page without a nextPageToken."
    done

    objects="$(jq -cn \
      --argjson existing "$objects" \
      --argjson incoming "$level_objects" '
        $existing + $incoming
        | sort_by(.objectTypeId, .primaryId)
        | unique_by(.objectTypeId, .primaryId)
      ')"

    (( level < depth )) || continue
    links="$(jq -cn --argjson existing "$links" --argjson incoming "$level_links" '
      $existing + $incoming
      | sort_by(.sourceTypeId, .sourceId, .linkId, .targetTypeId, .targetId)
      | unique_by(.sourceTypeId, .sourceId, .linkId, .targetTypeId, .targetId)
    ')"

    local candidates
    candidates="$(jq -cn \
      --argjson frontier "$frontier" \
      --argjson incoming "$level_links" \
      --argjson distance "$((level + 1))" '
        def selected($type; $id):
          any($frontier[]; .objectTypeId == $type and .primaryId == $id);
        [$incoming[]
          | if selected(.sourceTypeId; .sourceId) then
              {objectTypeId:.targetTypeId,primaryId:.targetId,distance:$distance}
            elif selected(.targetTypeId; .targetId) then
              {objectTypeId:.sourceTypeId,primaryId:.sourceId,distance:$distance}
            else empty
            end]
      ')"

    local merge
    merge="$(jq -cn \
      --argjson seen "$refs" \
      --argjson candidates "$candidates" \
      --argjson max "$max_objects" '
        def was_seen($candidate):
          any($seen[]; .objectTypeId == $candidate.objectTypeId and .primaryId == $candidate.primaryId);
        ($seen + $candidates
          | group_by(.objectTypeId, .primaryId)
          | map(min_by(.distance))
          | sort_by(.distance, .objectTypeId, .primaryId)) as $all
        | ($all[0:$max]) as $kept
        | {
            refs:$kept,
            frontier:[$kept[] | . as $candidate | select(was_seen($candidate) | not)],
            truncated:($all | length > $max)
          }
      ')"
    refs="$(jq -c '.refs' <<<"$merge")"
    frontier="$(jq -c '.frontier' <<<"$merge")"
    if [[ "$(jq -r '.truncated' <<<"$merge")" == "true" ]]; then
      truncated='true'
    fi
  done

  links="$(jq -c --argjson refs "$refs" '
    def included($type; $id):
      any($refs[]; .objectTypeId == $type and .primaryId == $id);
    [.[]
      | select(included(.sourceTypeId; .sourceId) and included(.targetTypeId; .targetId))
      | {
          sourceTypeId,
          sourceId,
          linkId,
          targetTypeId,
          targetId
        } + (if .properties == null then {} else {properties} end)]
    | sort_by(.sourceTypeId, .sourceId, .linkId, .targetTypeId, .targetId)
  ' <<<"$links")"

  local root_object related_objects relevant_types
  root_object="$(jq -ce --arg type "$object_type" --arg id "$primary_id" '
    [.[] | select(.objectTypeId == $type and .primaryId == $id)]
    | if length == 1 then .[0] else empty end
  ' <<<"$objects")" || fail "Object '$object_type/$primary_id' was not found."
  related_objects="$(jq -cn --argjson refs "$refs" --argjson objects "$objects" '
    [$refs[] as $ref
      | select($ref.distance > 0)
      | $objects[]
      | select(.objectTypeId == $ref.objectTypeId and .primaryId == $ref.primaryId)
      | . + {distance:$ref.distance}]
    | sort_by(.distance, .objectTypeId, .primaryId)
  ')"
  relevant_types='[]'
  if [[ "$full" == "true" ]]; then
    local relevant_type_id
    while IFS= read -r relevant_type_id; do
      [[ -n "$relevant_type_id" ]] || continue
      local definition
      definition="$(http_get "/api/object-types/$(encode_segment "$relevant_type_id")")"
      relevant_types="$(jq -cn \
        --argjson existing "$relevant_types" \
        --argjson definition "$definition" '
          $existing + [$definition] | sort_by(.id)
        ')"
    done <<<"$(jq -r 'map(.objectTypeId) | unique | .[]' <<<"$refs")"
  else
    root_object="$(jq -c 'del(.createdAt, .updatedAt)' <<<"$root_object")"
    related_objects="$(jq -c 'map(del(.createdAt, .updatedAt))' <<<"$related_objects")"
  fi

  jq -cn \
    --argjson object "$root_object" \
    --argjson relatedObjects "$related_objects" \
    --argjson links "$links" \
    --argjson objectTypes "$relevant_types" \
    --argjson depth "$depth" \
    --argjson maxObjects "$max_objects" \
    --argjson full "$full" \
    --argjson truncated "$truncated" '
      {
        object:$object,
        relatedObjects:$relatedObjects,
        links:$links,
        graph:{
          depth:$depth,
          maxObjects:$maxObjects,
          objectCount:(1 + ($relatedObjects | length)),
          linkCount:($links | length),
          truncated:$truncated
        }
      }
      + (if $full then {objectTypes:$objectTypes} else {} end)
    '
}

cmd_objects_get() {
  if is_help "${1:-}"; then
    printf '%s\n' "Usage: sixb objects get <object-type> <primary-id>..."
    return
  fi
  local object_type="${1:-}"
  require_value "objects get" "$object_type"
  shift || true
  [[ $# -gt 0 ]] || fail "objects get requires at least one primary id."
  require_runtime

  local ids_json body
  ids_json="$(jq -cn --args '$ARGS.positional' -- "$@")"
  body="$(jq -cn --arg type "$object_type" --argjson ids "$ids_json" '
    {
      query:{
        kind:"refs",
        refs:[$ids[] | {objectTypeId:$type,primaryId:.}]
      },
      includeTotal:false
    }
  ')"
  http_post_json "/api/objects/query" "$body"
}

cmd_objects_search() {

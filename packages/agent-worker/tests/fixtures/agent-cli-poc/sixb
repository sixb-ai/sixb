        case "$1" in
          --workflow) require_value "$1" "${2:-}"; args+=(--data-urlencode "workflowId=$2"); shift 2 ;;
          --status) require_value "$1" "${2:-}"; args+=(--data-urlencode "status=$2"); shift 2 ;;
          --started-after) require_value "$1" "${2:-}"; args+=(--data-urlencode "startedAfter=$2"); shift 2 ;;
          --started-before) require_value "$1" "${2:-}"; args+=(--data-urlencode "startedBefore=$2"); shift 2 ;;
          --limit) require_value "$1" "${2:-}"; args+=(--data-urlencode "limit=$2"); shift 2 ;;
          --offset) require_value "$1" "${2:-}"; args+=(--data-urlencode "offset=$2"); shift 2 ;;
          --order) require_value "$1" "${2:-}"; args+=(--data-urlencode "order=$2"); shift 2 ;;
          *) fail "Unknown workflow-runs list option '$1'." ;;
        esac
      done
      http_json "${args[@]}"
      ;;
    *) fail "Unknown workflow-runs command '$sub'." ;;
  esac
}

cmd_api() {
  local method="${1:-}"
  shift || true
  if [[ -z "$method" ]] || is_help "$method"; then
    print_api_help
    return
  fi
  case "$method" in
    get)
      is_help "${1:-}" && { print_api_help; return; }
      local path="${1:-}"
      require_value "api get" "$path"
      shift || true
      local output=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;
          *) fail "Unknown api get option '$1'." ;;
        esac
      done
      require_runtime
      validate_api_path "$path"
      if [[ -z "$output" ]]; then
        http_get "$path"
      else
        http_download "$output" "$(api_url "$path")"
        jq -cn --arg output "$output" '{downloaded:true,output:$output}'
      fi
      ;;
    post)
      is_help "${1:-}" && { print_api_help; return; }
      local path="${1:-}"
      require_value "api post" "$path"
      shift || true
      [[ "${1:-}" == "--file" ]] || fail "api post requires --file <path|->."
      require_value "--file" "${2:-}"
      [[ $# -eq 2 ]] || fail "api post accepts only a path and --file <path|->."
      require_runtime
      validate_api_path "$path"
      http_post_json "$path" "$(read_json "$2")"
      ;;
    *) fail "Unknown api method '$method'. Only get and post are supported." ;;
  esac
}

main() {
  local command="${1:-}"
  if [[ -z "$command" ]] || is_help "$command"; then
    print_main_help
    return
  fi
  shift || true
  case "$command" in
    --version|version) printf 'sixb agent CLI %s\n' "$SIXB_AGENT_CLI_VERSION" ;;
    doctor) cmd_doctor "$@" ;;
    context) cmd_context "$@" ;;
    project) cmd_project "$@" ;;
    ontology) cmd_ontology "$@" ;;
    objects) cmd_objects "$@" ;;
    telemetry) cmd_telemetry "$@" ;;
    actions) cmd_actions "$@" ;;
    action-runs) cmd_action_runs "$@" ;;
    files) cmd_files "$@" ;;
    workflows) cmd_workflows "$@" ;;
    workflow-runs) cmd_workflow_runs "$@" ;;
    api) cmd_api "$@" ;;
    *) fail "Unknown command '$command'. Run 'sixb --help'." ;;
  esac
}

main "$@"

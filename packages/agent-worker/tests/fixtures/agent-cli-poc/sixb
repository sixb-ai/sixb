    object)
      [[ $# -ge 2 ]] || fail "files download object requires object type and primary id."
      route="/api/objects/$(encode_segment "$1")/$(encode_segment "$2")/files/content"
      shift 2
      ;;
    action-run)
      require_value "files download action-run" "${1:-}"
      route="/api/action-runs/$(encode_segment "$1")/files/content"
      shift
      ;;
    workflow-run)
      require_value "files download workflow-run" "${1:-}"
      route="/api/workflow-runs/$(encode_segment "$1")/files/content"
      shift
      ;;
    *) fail "Unknown file download context '$context'." ;;
  esac
  local pointer="" output=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path) require_value "$1" "${2:-}"; pointer="$2"; shift 2 ;;
      --output) require_value "$1" "${2:-}"; output="$2"; shift 2 ;;

cmd_actions_request() {
  if is_help "${1:-}"; then
    print_actions_help
    return
  fi
  local action_id="${1:-}"
  require_value "actions request" "$action_id"
  shift || true
  local subject_type="" subject_id="" params_source="" run_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subject-type) require_value "$1" "${2:-}"; subject_type="$2"; shift 2 ;;
      --subject-id) require_value "$1" "${2:-}"; subject_id="$2"; shift 2 ;;
      --params-file) require_value "$1" "${2:-}"; params_source="$2"; shift 2 ;;
      --run-id) require_value "$1" "${2:-}"; run_id="$2"; shift 2 ;;
      *) fail "Unknown actions request option '$1'." ;;
    esac
  done
  [[ -z "$subject_type" && -z "$subject_id" || -n "$subject_type" && -n "$subject_id" ]] ||
    fail "--subject-type and --subject-id must be provided together."
  require_runtime
  local params='{}'
  [[ -z "$params_source" ]] || params="$(read_json "$params_source")"
  [[ "$(jq -r 'type' <<<"$params")" == "object" ]] || fail "Action params must be a JSON object."
  local body
  body="$(jq -cn \
    --arg subjectType "$subject_type" \
    --arg subjectId "$subject_id" \
    --arg runId "$run_id" \
    --argjson params "$params" '
      {params:$params}
      + (if $subjectType == "" then {} else {subject:{kind:"object",objectTypeId:$subjectType,primaryId:$subjectId}} end)
      + (if $runId == "" then {} else {runId:$runId} end)')"
  http_post_json "/api/actions/$(encode_segment "$action_id")" "$body"
}


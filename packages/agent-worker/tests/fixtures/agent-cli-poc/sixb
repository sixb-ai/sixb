cmd_objects_links() {
  if is_help "${1:-}"; then
    print_objects_help
    return
  fi
  local object_type="${1:-}"
  local primary_id="${2:-}"
  require_value "objects links object type" "$object_type"
  require_value "objects links primary id" "$primary_id"
  shift 2 || true
  require_runtime
  local link_id=""
  local direction="both"
  local page_size="1000"
  local page_token=""
  local include_objects="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --link) require_value "$1" "${2:-}"; link_id="$2"; shift 2 ;;
      --direction) require_value "$1" "${2:-}"; direction="$2"; shift 2 ;;
      --page-size) require_value "$1" "${2:-}"; page_size="$2"; shift 2 ;;
      --page-token) require_value "$1" "${2:-}"; page_token="$2"; shift 2 ;;
      --include-objects) include_objects="true"; shift ;;
      *) fail "Unknown objects links option '$1'." ;;
    esac
  done
  [[ "$direction" == "outgoing" || "$direction" == "incoming" || "$direction" == "both" ]] ||
    fail "--direction must be outgoing, incoming, or both."
  [[ "$page_size" =~ ^[1-9][0-9]*$ ]] || fail "--page-size must be an integer from 1 through 1000."
  page_size="$((10#$page_size))"
  (( page_size <= 1000 )) || fail "--page-size must be an integer from 1 through 1000."
  local body
  body="$(jq -cn \
    --arg type "$object_type" \
    --arg id "$primary_id" \
    --arg direction "$direction" \
    --arg linkId "$link_id" \
    --arg pageToken "$page_token" \
    --argjson pageSize "$page_size" \
    --argjson includeObjects "$include_objects" '
      {
        query:{kind:"refs",refs:[{objectTypeId:$type,primaryId:$id}]},
        direction:$direction,
        includeObjects:$includeObjects,
        pageSize:$pageSize
      }
      + (if $linkId == "" then {} else {linkId:$linkId} end)
      + (if $pageToken == "" then {} else {pageToken:$pageToken} end)
    ')"
  http_post_json "/api/objects/query/links" "$body"
}


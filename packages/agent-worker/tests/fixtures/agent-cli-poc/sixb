  local -a args=(--get "$(api_url "/api/objects/search")" --data-urlencode "q=$query")
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) require_value "$1" "${2:-}"; args+=(--data-urlencode "limit=$2"); shift 2 ;;
      *) fail "Unknown objects search option '$1'." ;;
    esac
  done
  http_json "${args[@]}"
}

cmd_objects_query() {
  if is_help "${1:-}"; then
    print_query_help
    return
  fi
  local source=""
  local include_total="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --file) require_value "$1" "${2:-}"; source="$2"; shift 2 ;;
      --include-total) include_total="true"; shift ;;
      --no-total) include_total="false"; shift ;;
      --example) require_value "$1" "${2:-}"; print_query_example "$2"; return ;;
      *) fail "Unknown objects query option '$1'." ;;
    esac
  done
  [[ -n "$source" ]] || fail "objects query requires --file <path|->."
  require_runtime
  local input body
  input="$(read_json "$source")"
  body="$(jq -cn --argjson input "$input" --argjson include "$include_total" '
    if ($input | type) == "object" and ($input | has("query")) then
      if ($input | has("includeTotal")) then $input else $input + {includeTotal:$include} end
    else {query:$input,includeTotal:$include}
    end')"
  http_post_json "/api/objects/query" "$body"
}


#!/usr/bin/env bash

set -euo pipefail

readonly SIXB_AGENT_CLI_VERSION="poc-1"
readonly SIXB_EXIT_USAGE=2
readonly SIXB_EXIT_API=3

json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

emit_error() {
  local code="$1"
  local message="$2"
  local status="${3:-}"
  local hint="${4:-}"

  printf '{"error":{"code":%s' "$(json_string "$code")"
  [[ -z "$status" ]] || printf ',"status":%s' "$status"
  printf ',"message":%s' "$(json_string "$message")"
  [[ -z "$hint" ]] || printf ',"hint":%s' "$(json_string "$hint")"
  printf '}}\n'
}

fail() {
  emit_error "${2:-invalid_arguments}" "$1" "" "${3:-}" >&2
  exit "$SIXB_EXIT_USAGE"
}

is_help() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]
}

require_value() {
  local flag="$1"
  local value="${2:-}"
  [[ -n "$value" ]] || fail "$flag requires a value."
}

require_runtime() {
  [[ -n "${SIXB_API_BASE_URL:-}" ]] ||
    fail "SIXB_API_BASE_URL is not set." "runtime_unavailable"
  [[ -n "$(command -v curl)" ]] ||
    fail "curl is required in the agent sandbox." "runtime_unavailable"
  [[ -n "$(command -v jq)" ]] ||
    fail "jq is required in the agent sandbox." "runtime_unavailable"
}

api_url() {
  local path="$1"
  printf '%s%s' "${SIXB_API_BASE_URL%/}" "$path"
}

encode_segment() {
  jq -rn --arg value "$1" '$value | @uri'
}

validate_api_path() {
  local path="$1"
  [[ "$path" == "/api" || "$path" == /api/* ]] ||
    fail "API paths must be relative and start with /api/."
  [[ "$path" != *"://"* ]] || fail "API paths must not contain an origin."
  [[ "$path" != *\\* && "$path" != *#* && "$path" != *"/../"* && "$path" != *"%2e"* && "$path" != *"%2E"* ]] ||
    fail "API paths must be relative and start with /api/."
}

read_json() {
  local source="$1"
  local parsed
  if [[ "$source" == "-" ]]; then
    if ! parsed="$(jq -ce . 2>&1)"; then
      fail "Standard input is not valid JSON." "invalid_json"
    fi
    printf '%s\n' "$parsed"
    return
  fi
  [[ -f "$source" ]] || fail "JSON file '$source' does not exist."
  if ! parsed="$(jq -ce . "$source" 2>&1)"; then
    fail "JSON file '$source' is not valid JSON." "invalid_json"
  fi
  printf '%s\n' "$parsed"
}

http_json() {
  local response
  if ! response="$(curl -sS --write-out $'\n%{http_code}' "$@" 2>&1)"; then
    emit_error \
      "api_unreachable" \
      "The Sixb API gateway could not be reached." \
      "" \
      "Run 'sixb doctor' to verify the sandbox runtime and gateway." >&2
    exit "$SIXB_EXIT_API"
  fi

  local status="${response##*$'\n'}"
  local body="${response%$'\n'*}"
  if [[ ! "$status" =~ ^[0-9]{3}$ ]]; then
    emit_error "invalid_api_response" "The Sixb API returned an invalid HTTP status." >&2
    exit "$SIXB_EXIT_API"
  fi
  if ((10#$status < 200 || 10#$status >= 300)); then
    local code="http_error"
    local message="The Sixb API request failed with HTTP $status."
    local hint=""
    local parsed
    if parsed="$(jq -er '
      if (.error | type) == "object" then .error.code // empty else empty end
    ' <<<"$body" 2>&1)"; then
      code="$parsed"
    fi
    if parsed="$(jq -er '
      if (.error | type) == "object" then .error.message // empty
      elif (.error | type) == "string" then .error
      else empty end
    ' <<<"$body" 2>&1)"; then
      message="$parsed"
    fi
    if parsed="$(jq -er '
      if (.error | type) == "object" then .error.hint // empty else empty end
    ' <<<"$body" 2>&1)"; then
      hint="$parsed"
    fi
    emit_error "$code" "$message" "$((10#$status))" "$hint" >&2
    exit "$SIXB_EXIT_API"
  fi

  printf '%s\n' "$body"
}

http_get() {
  local path="$1"
  http_json "$(api_url "$path")"
}

http_post_json() {
  local path="$1"
  local body="$2"
  http_json \
    -H "Content-Type: application/json" \
    -X POST "$(api_url "$path")" \
    --data-binary "$body"
}

http_download() {
  local output="$1"
  shift
  local status
  if ! status="$(curl -sS --write-out '%{http_code}' "$@" --output "$output" 2>&1)"; then
    emit_error \
      "api_unreachable" \
      "The Sixb API gateway could not be reached." \
      "" \
      "Run 'sixb doctor' to verify the sandbox runtime and gateway." >&2
    exit "$SIXB_EXIT_API"
  fi
  if [[ ! "$status" =~ ^[0-9]{3}$ ]]; then
    emit_error "invalid_api_response" "The Sixb API returned an invalid HTTP status." >&2
    exit "$SIXB_EXIT_API"
  fi
  if ((10#$status < 200 || 10#$status >= 300)); then
    emit_error \
      "http_error" \
      "The Sixb API request failed with HTTP $status." \
      "$((10#$status))" >&2
    exit "$SIXB_EXIT_API"
  fi
}


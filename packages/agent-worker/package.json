{
  "name": "@sixb/agent-worker",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "sixbBuild": {
    "assets": [
      {
        "from": "./src/skills",
        "to": "./dist/skills"
      }
    ]
  },
  "dependencies": {
    "@sixb/core": "workspace:*",
    "ai": "^7.0.4"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}

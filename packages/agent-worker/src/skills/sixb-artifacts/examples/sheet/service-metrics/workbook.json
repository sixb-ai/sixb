        "Service revenue": { "type": "currency", "currency": "USD" },
        "Parts cost": { "type": "currency", "currency": "USD" },
        "Quarter end": "date"
      }
    },
    {
      "name": "Regions",
      "frozenColumns": 1,
      "columns": {
        "Visits": "number",

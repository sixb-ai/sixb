{
  "sheets": [
    {
      "name": "Inventory",
      "frozenColumns": 1,
      "columns": {
        "Status": {
          "type": "tag",
          "tones": { "Reorder": "negative", "Low": "warning", "In stock": "positive" }
        },
        "On hand": { "type": "number", "highlight": "bars" },
        "Reorder point": "number",
        "Lead time (weeks)": "number",
        "Unit cost": { "type": "currency", "currency": "USD" },
        "Last received": "date",
        "Supplier": "link",
        "Counted": "boolean"
      },
      "descriptions": { "Counted": "Counted by hand in the September cycle count." },
      "widths": { "Part": 200 }
    },
    {
      "name": "Spend",
      "columns": {
        "Q3 spend": { "type": "currency", "currency": "USD", "decimals": 0 }
      }
    }
  ],
  "charts": [
    {
      "name": "spend-by-category",
      "type": "pie",
      "sheet": "Spend",
      "x": "Category",
      "y": "Q3 spend",
      "title": "Parts spend by category, Q3"
    },
    {
      "name": "parts-by-category",
      "type": "bar",
      "sheet": "Inventory",
      "x": "Category",
      "aggregate": "count",
      "title": "Parts stocked, by category"
    }
  ]
}

{
  "name": "@sixb/atlas",
  "version": "0.1.3",
  "description": "Atlas, the built-in operations UI for Sixb",
  "keywords": [
    "sixb",
    "bun",
    "ui",
    "admin",
    "react"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "packages/atlas"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:ui-css": "bun ./src/buildCss.ts",
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@sixb/agent-ui": "workspace:^",
    "@sixb/app": "workspace:^",
    "@sixb/client": "workspace:^",
    "@sixb/core": "workspace:^",
    "@sixb/ui": "workspace:^",
    "@tailwindcss/cli": "^4.2.2",
    "@tanstack/react-query": "^5.0.0",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.562.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.14.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

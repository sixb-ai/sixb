{
  "name": "@sixb/sandboxes-azure",
  "version": "0.1.1",
  "description": "Azure Container Apps sandbox provider for Sixb agents (preview)",
  "keywords": [
    "sixb",
    "bun",
    "sandbox",
    "agents",
    "azure"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "sandboxes/azure"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && bun run build:guest",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build",
    "build:guest": "bun build ./src/guest/supervisor.ts --target=node --format=esm --outfile=./dist/guest/supervisor.mjs",
    "test:e2e": "bun ../../scripts/ci-guard.ts --stall 120 --max 300 bun test ./tests/published-artifacts.e2e.ts"
  },
  "dependencies": {
    "@azure/core-auth": "1.10.1",
    "@azure/identity": "4.13.0"
  },
  "peerDependencies": {
    "@sixb/core": "workspace:^"
  },
  "devDependencies": {
    "@sixb/core": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}

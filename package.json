{
  "name": "sixb",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "auth/*",
    "packages/*",
    "models/*",
    "connectors/*",
    "deploy/*",
    "env/*",
    "broker/*",
    "queues/*",
    "sandboxes/*",
    "storage/*",
    "loggers/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:types && bun run build:js",
    "build:types": "tsc -b tsconfig.build.json",
    "build:js": "bun --filter './packages/*' --filter './models/*' --filter './auth/*' --filter './connectors/*' --filter './deploy/*' --filter './env/*' --filter './broker/*' --filter './loggers/*' --filter './queues/*' --filter './sandboxes/*' --filter './storage/*' build",
    "build:clean": "rm -rf {packages,models,auth,connectors,deploy,env,broker,queues,sandboxes,storage,loggers}/*/{dist,.tsbuild}",
    "release": "bun install --frozen-lockfile && bun run build && bun run test:publish",
    "release:plan": "bun scripts/publish.ts --plan",
    "release:publish": "bun scripts/publish.ts",
    "release:promote": "bun scripts/promote.ts",
    "dev": "bun sixb dev",
    "test": "bun test --parallel=2",
    "test:ci": "bun scripts/ci-guard.ts --stall 60 --max 420 bun test --parallel=2",
    "test:e2e": "bun run --workspaces --if-present test:e2e",
    "test:all": "bun run test && bun run test:e2e",
    "lint": "biome check auth/*/src packages/*/src models/*/src connectors/*/src sandboxes/*/src",
    "typecheck": "bun check --no-script -b -p tsconfig.build.json && bun run typecheck:tests && bun run typecheck:template && bun run docs:typecheck",
    "typecheck:tests": "bun check --no-script -p tsconfig.tests.json",
    "typecheck:template": "bun check --no-script -p packages/create-sixb/tsconfig.json",
    "typecheck:consumers": "bun sixb typegen --entry packages/client/tests/type-programs/ontology-registry/sixb.config.ts && tsc -p packages/client/tests/type-programs/ontology-registry && bun --filter '@sixb/example-*' typecheck",
    "link-cli": "ln -sf \"$(pwd)/packages/cli/src/index.tsx\" ~/.bun/bin/sixb && echo 'Linked sixb CLI to ~/.bun/bin/sixb'",
    "sixb": "bun packages/cli/src/index.tsx",
    "create-sixb": "bun packages/create-sixb/src/index.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "generate:client": "bun --filter @sixb/server generate:openapi && bun --filter @sixb/client generate && bun check:fix",
    "generate:sandbox-cli": "bun --filter @sixb/cli-core generate:sandbox-cli",
    "docs:dev": "bun --filter @sixb/docs dev",
    "docs:build": "bun --filter @sixb/docs build",
    "docs:typecheck": "bun --filter @sixb/docs typecheck",
    "test:publish": "bun scripts/pack-smoke.ts",
    "ui:dev": "bun --filter @sixb/ui dev",
    "ui:add": "bun --filter @sixb/ui shadcn:add"
  },
  "overrides": {
    "@types/bun": "1.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/bun": "latest",
    "bun": "1.4.4",
    "typescript": "^5.7.0"
  }
}

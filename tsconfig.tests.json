{
  // Type-checks every package's test files against the .d.ts emitted by the
  // build graph. Package `src` is NOT checked here — that happens in
  // `tsconfig.build.json` (`bun run build:types`), which runs first. The globs
  // below cover all build-graph workspace roots, so new packages are picked up
  // automatically. Examples/docs keep their own `typegen && tsc`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tests.tsbuildinfo"
  },
  "include": [
    // Release tooling and its tests are not a package, so they check against source directly.
    "scripts/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "models/*/tests/**/*.ts",
    "models/*/tests/**/*.tsx",
    "connectors/*/tests/**/*.ts",
    "connectors/*/tests/**/*.tsx",
    "storage/*/tests/**/*.ts",
    "broker/*/tests/**/*.ts",
    "queues/*/tests/**/*.ts",
    "sandboxes/*/tests/**/*.ts",
    "loggers/*/tests/**/*.ts",
    "auth/*/tests/**/*.ts"
  ]
}

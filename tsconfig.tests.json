{
  // Type-checks every package's test files with `bun check` (`bun run typecheck:tests`). The root
  // `paths` map resolves `@sixb/*` to source, as in the editor, so nothing has to be built first.
  // The globs below cover all build-graph workspace roots, so new packages are picked up
  // automatically.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "include": [
    // Release tooling and its tests are not a package, so they check against source directly.
    "scripts/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "models/*/tests/**/*.ts",
    "models/*/tests/**/*.tsx",
    "connectors/*/tests/**/*.ts",
    "connectors/*/tests/**/*.tsx",
    "deploy/*/tests/**/*.ts",
    "env/*/tests/**/*.ts",
    "storage/*/tests/**/*.ts",
    "broker/*/tests/**/*.ts",
    "queues/*/tests/**/*.ts",
    "sandboxes/*/tests/**/*.ts",
    "loggers/*/tests/**/*.ts",
    "auth/*/tests/**/*.ts"
  ],
  // Each type program owns an ambient ontology registry, so `typecheck:consumers` checks it as its
  // own program instead of leaking that registry into every test file here.
  "exclude": ["*/*/tests/type-programs/**"]
}

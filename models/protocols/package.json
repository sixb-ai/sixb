{
  "name": "@sixb/model-protocols",
  "version": "0.1.1",
  "description": "Internal model protocol implementations for Sixb providers",
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "models/protocols"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/responses.js",
  "types": "./dist/responses.d.ts",
  "exports": {
    "./chat": {
      "types": "./dist/chat.d.ts",
      "bun": "./src/chat.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "bun": "./src/messages.ts",
      "import": "./dist/messages.js",
      "default": "./dist/messages.js"
    },
    "./responses": {
      "types": "./dist/responses.d.ts",
      "bun": "./src/responses.ts",
      "import": "./dist/responses.js",
      "default": "./dist/responses.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@sixb/core": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}

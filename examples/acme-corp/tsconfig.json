{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["bun", "node"],
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tsbuildinfo"
  },
  "include": [
    "actions/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "connectors/**/*.ts",
    "datasets/**/*.ts",
    "functions/**/*.ts",
    "lib/**/*.ts",
    "ontology/**/*.ts",
    "pipelines/**/*.ts",
    "projections/**/*.ts",
    "rules/**/*.ts",
    "schedules/**/*.ts",
    "scripts/**/*.ts",
    "syncs/**/*.ts",
    "tests/**/*.ts",
    "workflows/**/*.ts",
    "sixb.config.ts",
    ".sixb/types/**/*.d.ts"
  ]
}

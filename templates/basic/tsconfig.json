{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "ontology/**/*.ts",
    "functions/**/*.ts",
    "sixb.config.ts"
  ]
}

# Production providers (used when NODE_ENV=production)
DATABASE_URL=postgres://sixb:sixb@localhost:5432/sixb
POSTGRES_SCHEMA=sixb
REDIS_URL=redis://localhost:6379

S3_BUCKET=sixb
S3_REGION=us-east-1


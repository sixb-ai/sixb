{
  "name": "@sixb/connector-microsoft",
  "version": "0.1.0",
  "description": "Typed Microsoft Graph connector for Sixb (SharePoint sites and files)",
  "keywords": [
    "sixb",
    "bun",
    "connector",
    "microsoft",
    "sharepoint",
    "onedrive"
  ],
  "homepage": "https://sixb.ai",
  "bugs": {
    "url": "https://github.com/sixb-ai/sixb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixb-ai/sixb.git",
    "directory": "connectors/microsoft"
  },
  "author": "Sixb contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test ./tests/*.e2e.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@sixb/connector-rest": "workspace:^"
  },
  "peerDependencies": {
    "@sixb/core": "workspace:^"
  },
  "devDependencies": {
    "@sixb/core": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
